# Copy to .env.local; never commit credentials
EDGE_AGENT_ID=edge-eu-02
EDGE_AGENT_REGION=eu-1
EDGE_PUBLIC_IP=185.194.190.84
EDGE_SNI_CAPACITY=5000
EDGE_ROUTE_CAPACITY=0
# Full Route: set EDGE_ROUTE_CAPACITY > 0 and provide NETWORK_CONTROL_KEY.
# config.yml advertises EDGE_PUBLIC_IP as the route IPv4 when enabled.
# This IP must be assigned to this host and reachable from clients.
# With one public IPv4, disable SNI initially to avoid conflicting port 443 handling.
EDGE_SNI_ENABLED=true
EDGE_SNI_LISTEN_ADDRESS=0.0.0.0:443

# DNS-Control API endpoint and agent-specific Bearer token.
# Must match DNS_CONTROL_AGENT_TOKEN on the Platform DNS-Control service.
# Do NOT use the general DNS_CONTROL_API_TOKEN.
DNS_CONTROL_API_URL=https://dns-api.wraplink.ir
DNS_CONTROL_AGENT_TOKEN=

WRAPLINK_BACKEND_URL=https://api.wraplink.ir
# Required for Full Route (EDGE_ROUTE_CAPACITY > 0); must match the backend network control credential.
NETWORK_CONTROL_KEY=

# Optional SNI disconnect-command polling (disabled when unset).
# Requires Backend WRAPLINK_NETWORK_SESSIONS_ENABLED=true and a separately
# provisioned per-agent credential bound to EDGE_AGENT_ID; never reuse control keys.
WRAPLINK_SESSION_AGENT_TOKEN=

# Optional private diagnostics API authentication token.
# Only used if config.yml diagnostics.enabled=true and diagnostics.token references this variable.
# Generate with: openssl rand -hex 32. Do not commit real token values.
WRAPLINK_DIAGNOSTICS_TOKEN=

# Optional authenticated origin DNS endpoint for DNS Control.
# Only effective if config.yml origin_dns.enabled=true and token references
# ${DNS_ORIGIN_AGENT_TOKEN}. Generate a unique value: openssl rand -hex 32.
# Never reuse DNS_CONTROL_AGENT_TOKEN, NETWORK_CONTROL_KEY or session credentials.
DNS_ORIGIN_AGENT_TOKEN=

# Copy to .env.local; never commit credentials
EDGE_AGENT_ID=edge-eu-02
EDGE_AGENT_REGION=eu-1
EDGE_PUBLIC_IP=185.194.190.84
EDGE_SNI_CAPACITY=5000
EDGE_ROUTE_CAPACITY=0
EDGE_SNI_ENABLED=true
EDGE_SNI_LISTEN_ADDRESS=0.0.0.0:443

# DNS-Control API endpoint and agent-specific Bearer token.
# Must match DNS_CONTROL_AGENT_TOKEN on the Platform DNS-Control service.
# Do NOT use the general DNS_CONTROL_API_TOKEN.
DNS_CONTROL_API_URL=https://dns-api.wraplink.ir
DNS_CONTROL_AGENT_TOKEN=

WRAPLINK_BACKEND_URL=https://api.wraplink.ir
NETWORK_CONTROL_KEY=

# Optional private diagnostics API authentication token.
# Only used if config.yml diagnostics.enabled=true and diagnostics.token references this variable.
# Generate with: openssl rand -hex 32. Do not commit real token values.
WRAPLINK_DIAGNOSTICS_TOKEN=
